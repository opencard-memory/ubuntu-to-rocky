"""
deb2rpm - Ubuntu/Debian 명령어를 Rocky Linux(RHEL)용으로 자동 변환해서 실행

사용법
  sudo ./deb2rpm --install        # 설치: apt, dpkg, ufw ... 를 그대로 입력해도 변환 실행
  apt install -y nginx            # (설치 후) 그냥 우분투처럼 입력
  deb2rpm apt update              # 직접 호출
  deb2rpm "apt update && apt install -y build-essential"
  deb2rpm -n apt install nginx    # 실행 없이 변환 결과만 표시 (dry-run)
  deb2rpm                         # 대화형 셸 (우분투 명령 입력 -> 변환 -> 실행)
Python 3.6+ (Rocky 8/9 호환)
"""
